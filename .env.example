# Copy to .env.local. Never commit .env.local.

# ---------------------------------------------------------------------------
# Required for the magnetocaloric console on the landing page.
#
# A Neon database with the `vector` extension, holding the ingested document
# corpus and the synthetic rig telemetry. /api/health, /api/overview and
# /api/chat all refuse without it: the console renders its placeholder and the
# corpus figure in the hero shows a dash. Nothing else on the site needs it —
# the profile agent answers from a committed JSON corpus.
#
# Every query this project makes is a SELECT, so pointing several deployments
# at one database costs nothing. Seeding is `npm run ingest` and
# `npm run seed:telemetry`.
# ---------------------------------------------------------------------------
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Required for both agents. Without it /api/chat and /api/profile return 503.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=""

# Router and both spokes: classification and function calling, not prose.
OPENAI_MODEL="gpt-4o-mini"
# Final answer only. Falls back to OPENAI_MODEL. One call per turn, so this is
# the one worth upgrading independently.
OPENAI_SYNTHESIS_MODEL=""
# Must match what the corpus was embedded with, or every similarity is noise.
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# ---------------------------------------------------------------------------
# Tunables. Every default below is also the default in lib/config.ts, so an
# unset variable changes nothing — these exist so a deployment states what it
# is running rather than implying it.
# ---------------------------------------------------------------------------

# Cosine similarity below which a chunk never enters context. Measured by
# sweeping the retrieval golden set, not chosen. Re-run the calibration when
# the corpus or the embedding model changes.
GROUNDING_SIMILARITY_FLOOR="0.35"
AGENT_MAX_TOOL_ITERATIONS="3"
AGENT_MAX_ARG_RETRIES="2"

# An unauthenticated endpoint spending a real key, so cap both dimensions.
# lib/rate-limit.ts is deliberately honest about what this is: an in-process
# counter is a spend brake, not a security control.
RATE_LIMIT_PER_MINUTE="10"
MAX_OUTPUT_TOKENS="700"
